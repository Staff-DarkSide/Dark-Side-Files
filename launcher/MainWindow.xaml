<Window x:Class="DarkSideLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DARKSIDE Launcher" Width="1100" Height="620"
        WindowStyle="None" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="#05050A"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="MainButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F3E9E9"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="2" BorderThickness="1"
                                BorderBrush="#C05050" Background="#8B1A1F">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B02228"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#3A2224"/>
                                <Setter Property="Foreground" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="Background" Value="#CC0A0A12"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#CC2A2A3A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Image Source="/Assets/background.png" Stretch="UniformToFill"/>

        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0.55"/>
                    <GradientStop Color="#CC000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Top" Margin="0,8,8,0">
            <Button Style="{StaticResource GhostButton}" Content="—" Width="30" Height="24"
                    Padding="0" Margin="0,0,4,0" Click="Min_Click"/>
            <Button Style="{StaticResource GhostButton}" Content="✕" Width="30" Height="24"
                    Padding="0" Click="Close_Click"/>
        </StackPanel>

        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Width="420" Margin="0,0,0,22">
            <TextBlock x:Name="StatusText" Text="Starting..." Foreground="#E8E0E0"
                       FontFamily="Georgia" FontSize="13" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>

            <ProgressBar x:Name="DownloadBar" Height="4" Minimum="0" Maximum="100"
                         BorderThickness="0" Foreground="#C0262D" Background="#33FFFFFF"
                         Visibility="Hidden" Margin="0,0,0,8"/>

            <Button x:Name="MainButton" Style="{StaticResource MainButton}" Height="44"
                    Content="PLEASE WAIT" IsEnabled="False" Click="MainButton_Click"/>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" IsReadOnly="True" Background="#CC0A0A12"
                         Foreground="#DDDDDD" BorderBrush="#66FFFFFF" Padding="6,4"
                         VerticalContentAlignment="Center" FontSize="12"/>
                <Button x:Name="BrowseButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                        Content="Browse..." Margin="6,0,0,0" Click="Browse_Click"/>
            </Grid>

            <TextBlock x:Name="FooterText" Foreground="#99FFFFFF" FontSize="10"
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>
